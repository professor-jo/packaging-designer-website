---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { getProjects } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { title, client, year, category, summary, role, cover, coverAlt, gallery } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <article>
    <header class="wrap intro">
      <a class="back label" href="/">← All work</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="label">
        <div><dt>Client</dt><dd>{client}</dd></div>
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Category</dt><dd>{category}</dd></div>
        {role.length > 0 && <div><dt>Role</dt><dd>{role.join(', ')}</dd></div>}
      </dl>
    </header>

    <div class="wrap">
      <Frame>
        <Image src={cover} alt={coverAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
      </Frame>
    </div>

    <div class="wrap body">
      <div class="prose"><Content /></div>
    </div>

    {
      gallery.length > 0 && (
        <div class="wrap gallery">
          {gallery.map((g) => (
            <figure class:list={{ wide: g.wide }}>
              <Frame>
                <Image
                  src={g.src}
                  alt={g.alt}
                  widths={g.wide ? [800, 1400, 2000] : [480, 800, 1200]}
                  sizes={g.wide ? '100vw' : '(max-width: 720px) 100vw, 50vw'}
                />
              </Frame>
              {g.caption && <figcaption class="label">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap" aria-label="Next project">
          <div class="next">
            <span class="label">Next project</span>
            <a href={`/work/${next.id}/`}>{next.data.title} →</a>
          </div>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .intro {
    padding-block: 32px 56px;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(56px, 10vw, 128px);
    margin-top: 32px;
  }
  .summary {
    font-size: 17px;
    max-width: 48ch;
    margin: 24px 0 0;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 2px dashed var(--ink);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
  }
  .body {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .prose {
    max-width: 680px;
    margin-left: auto;
    font-family: var(--font-text);
    font-size: 18px;
    line-height: 1.65;
  }
  .prose :global(h2) {
    font-size: 40px;
    margin: 48px 0 12px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 1em;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  figure {
    margin: 0;
  }
  figure.wide {
    grid-column: 1 / -1;
  }
  figure :global(img),
  article :global(.frame img) {
    width: 100%;
  }
  figcaption {
    margin-top: 12px;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
  .next {
    margin-top: clamp(64px, 10vw, 120px);
    padding-top: 32px;
    border-top: 2px dashed var(--ink);
  }
  .next a {
    display: block;
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 7vw, 88px);
    line-height: 0.95;
    text-transform: uppercase;
    text-decoration: none;
  }
  .next a:hover {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
