---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { getProjects } from '../../data/projects';
import { url } from '../../data/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, client, year, category, summary, role, cover, coverAlt, gallery } = project.data;
---

<Base title={title} description={summary}>
  <article>
    <header class="wrap intro">
      <a class="back label" href={url()}>← All work</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="label">
        <div><dt>Client</dt><dd>{client}</dd></div>
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Category</dt><dd>{category}</dd></div>
        {role.length > 0 && <div><dt>Role</dt><dd>{role.join(', ')}</dd></div>}
      </dl>
    </header>

    <div class="wrap">
      <Frame>
        <button type="button" class="zoom" aria-label="Enlarge image">
          <Image src={cover} alt={coverAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
        </button>
      </Frame>
    </div>

    {
      gallery.length > 0 && (
        <div class="wrap gallery">
          {gallery.map((g) => (
            <figure class:list={{ wide: g.wide }}>
              {g.caption && <figcaption class="label">{g.caption}</figcaption>}
              <Frame>
                <button type="button" class="zoom" aria-label="Enlarge image">
                  <Image
                    src={g.src}
                    alt={g.alt}
                    widths={g.wide ? [800, 1400, 2000] : [480, 800, 1200]}
                    sizes={g.wide ? '100vw' : '(max-width: 720px) 100vw, 50vw'}
                  />
                </button>
              </Frame>
            </figure>
          ))}
        </div>
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap" aria-label="More projects">
          <div class="pager">
            <a class="prev" href={url(`/work/${prev.id}/`)}>
              <span class="label">← Previous project</span>
              <span class="title">{prev.data.title}</span>
            </a>
            <a class="next" href={url(`/work/${next.id}/`)}>
              <span class="label">Next project →</span>
              <span class="title">{next.data.title}</span>
            </a>
          </div>
        </nav>
      )
    }
  </article>

  <dialog id="zoom" aria-label="Enlarged image">
    <button type="button" class="zoom-close label" aria-label="Close">Close ×</button>
    <div class="zoom-body">
      <img alt="" />
    </div>
    <p class="zoom-hint label">Tap image to see full size</p>
  </dialog>
</Base>

<script>
  // Tap any project image to view it full screen; tap again to toggle full size.
  const box = document.querySelector<HTMLDialogElement>('#zoom')!;
  const big = box.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('button.zoom').forEach((btn) =>
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img')!;
      // Use the largest file from the srcset.
      const largest = img.srcset
        .split(',')
        .map((c) => c.trim().split(/\s+/))
        .sort((a, b) => parseInt(b[1]) - parseInt(a[1]))[0];
      big.src = largest ? largest[0] : img.currentSrc || img.src;
      big.alt = img.alt;
      box.classList.remove('full');
      box.showModal();
    }),
  );
  big.addEventListener('click', () => box.classList.toggle('full'));
  box.querySelector('.zoom-close')!.addEventListener('click', () => box.close());
  box.addEventListener('click', (e) => {
    if (e.target === box) box.close();
  });
</script>

<style>
  .intro {
    padding-block: 32px 56px;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(56px, 10vw, 128px);
    margin-top: 32px;
  }
  .summary {
    font-size: 17px;
    max-width: 48ch;
    margin: 24px 0 0;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 2px dashed var(--ink);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
  }
  .gallery {
    margin-top: clamp(48px, 8vw, 96px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  /* Caption + image share rows across the pair, so the images line up
     even when one caption wraps onto more lines than the other. */
  figure {
    margin: 0;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
  }
  figure > figcaption {
    align-self: end;
  }
  figure.wide {
    grid-column: 1 / -1;
  }
  figure :global(img),
  article :global(.frame img) {
    width: 100%;
  }
  figcaption {
    margin-bottom: 16px;
    font-family: var(--font-text);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
  }
  button.zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  #zoom {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 56px 12px 40px;
    border: 0;
    background: rgb(20 14 8);
  }
  #zoom::backdrop {
    background: rgb(20 14 8);
  }
  .zoom-body {
    width: 100%;
    height: 100%;
    overflow: auto;
    display: grid;
    place-items: center;
  }
  .zoom-body img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    cursor: zoom-in;
  }
  #zoom.full .zoom-body {
    place-items: start;
  }
  #zoom.full .zoom-body img {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
  .zoom-close {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: var(--font-mono);
    padding: 8px 12px;
    min-height: 40px;
    background: var(--kraft);
    color: var(--ink);
    border: 2px solid var(--ink);
    cursor: pointer;
  }
  .zoom-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    margin: 0;
    text-align: center;
    color: var(--paper);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: clamp(64px, 10vw, 120px);
    padding-top: 32px;
    border-top: 2px dashed var(--ink);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .pager .next {
    align-items: flex-end;
    text-align: right;
  }
  .pager .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pager a:hover .title {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .gallery,
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
