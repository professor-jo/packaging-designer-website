---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { getProjects } from '../../data/projects';
import { url } from '../../data/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, client, year, category, summary, role, cover, coverAlt, gallery } = project.data;
---

<Base title={title} description={summary}>
  <article>
    <header class="wrap intro">
      <a class="back label" href={url()}>← All work</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="label">
        <div><dt>Client</dt><dd>{client}</dd></div>
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Category</dt><dd>{category}</dd></div>
        {role.length > 0 && <div><dt>Role</dt><dd>{role.join(', ')}</dd></div>}
      </dl>
    </header>

    <div class="wrap">
      <Frame>
        <Image src={cover} alt={coverAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
      </Frame>
    </div>

    {
      gallery.length > 0 && (
        <div class="wrap gallery">
          {gallery.map((g) => (
            <figure class:list={{ wide: g.wide }}>
              {g.caption && <figcaption class="label">{g.caption}</figcaption>}
              <Frame>
                <Image
                  src={g.src}
                  alt={g.alt}
                  widths={g.wide ? [800, 1400, 2000] : [480, 800, 1200]}
                  sizes={g.wide ? '100vw' : '(max-width: 720px) 100vw, 50vw'}
                />
              </Frame>
            </figure>
          ))}
        </div>
      )
    }

    {
      next.id !== project.id && (
        <nav class="wrap" aria-label="More projects">
          <div class="pager">
            <a class="prev" href={url(`/work/${prev.id}/`)}>
              <span class="label">← Previous project</span>
              <span class="title">{prev.data.title}</span>
            </a>
            <a class="next" href={url(`/work/${next.id}/`)}>
              <span class="label">Next project →</span>
              <span class="title">{next.data.title}</span>
            </a>
          </div>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .intro {
    padding-block: 32px 56px;
  }
  .back {
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(56px, 10vw, 128px);
    margin-top: 32px;
  }
  .summary {
    font-size: 17px;
    max-width: 48ch;
    margin: 24px 0 0;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding-top: 20px;
    border-top: 2px dashed var(--ink);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
  }
  .gallery {
    margin-top: clamp(48px, 8vw, 96px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  /* Caption + image share rows across the pair, so the images line up
     even when one caption wraps onto more lines than the other. */
  figure {
    margin: 0;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
  }
  figure > figcaption {
    align-self: end;
  }
  figure.wide {
    grid-column: 1 / -1;
  }
  figure :global(img),
  article :global(.frame img) {
    width: 100%;
  }
  figcaption {
    margin-bottom: 16px;
    font-family: var(--font-text);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: clamp(64px, 10vw, 120px);
    padding-top: 32px;
    border-top: 2px dashed var(--ink);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
  }
  .pager .next {
    align-items: flex-end;
    text-align: right;
  }
  .pager .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pager a:hover .title {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .gallery,
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
