---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../data/projects';
import { mosaicSize } from '../data/mosaic';
import { site } from '../data/site';

const projects = await getProjects();
const categories = [...new Set(projects.map((p) => p.data.category))];
const [before, after] = site.headline.split(site.headlineAccent);
---

<Base>
  <section class="wrap hero">
    <h1>
      {before}{after !== undefined ? <><span class="accent">{site.headlineAccent}</span>{after}</> : null}
    </h1>
    <div class="side">
      <p>{site.intro}</p>
      {site.available && <p class="stamp label">Based in {site.location} — open for work</p>}
    </div>
  </section>

  <section class="wrap" aria-label="Work">
    <div class="bar">
      {
        categories.length > 1 && (
          <div class="filters label" role="group" aria-label="Filter by category">
            <button type="button" data-filter="all" aria-pressed="true">All</button>
            {categories.map((c) => (
              <button type="button" data-filter={c} aria-pressed="false">
                {c}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} size={mosaicSize(i)} eager={i < 2} />)}
    </div>

    <!-- Phones: the grid becomes a swipe carousel; these dots show and move the position. -->
    <div class="dots" aria-label="Choose project">
      {
        projects.map((p, i) => (
          <button type="button" aria-label={`Show ${p.data.title}`} aria-current={i === 0 ? 'true' : undefined} />
        ))
      }
      <span class="count label" aria-live="polite">1 / {projects.length}</span>
    </div>
  </section>
</Base>

<script>
  import { mosaicSize } from '../data/mosaic';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = [...document.querySelectorAll<HTMLElement>('.grid > [data-category]')];
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      // Re-flow the mosaic so the visible cards keep the big/small rhythm.
      let i = 0;
      for (const c of cards) {
        c.hidden = f !== 'all' && c.dataset.category !== f;
        if (!c.hidden) c.dataset.size = mosaicSize(i++);
      }
    }),
  );

  // Carousel dots (phones). Track which card is closest to the left edge.
  const grid = document.querySelector<HTMLElement>('.grid')!;
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.dots button')];
  const count = document.querySelector<HTMLElement>('.dots .count')!;
  dots.forEach((d, i) => d.addEventListener('click', () => cards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' })));
  let ticking = false;
  grid.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      const left = grid.getBoundingClientRect().left;
      let best = 0;
      cards.forEach((c, i) => {
        if (Math.abs(c.getBoundingClientRect().left - left) < Math.abs(cards[best].getBoundingClientRect().left - left)) best = i;
      });
      dots.forEach((d, i) => (i === best ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      count.textContent = `${best + 1} / ${cards.length}`;
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    padding-block: clamp(48px, 8vw, 64px) 56px;
  }
  h1 {
    grid-column: span 8;
    font-size: clamp(52px, 7.5vw, 96px);
  }
  .accent {
    color: var(--accent);
  }
  .side {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 14px;
  }
  .side p {
    margin: 0;
  }
  .stamp {
    align-self: flex-start;
    padding: 10px 14px;
    border: 2px solid var(--ink);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-top: 2px dashed var(--ink);
    margin-bottom: 32px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filters button {
    font: inherit;
    padding: 8px 14px;
    min-height: 40px;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--kraft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .grid > :global([hidden]) {
    display: none;
  }
  .dots {
    display: none;
  }
  @media (max-width: 900px) {
    h1,
    .side {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .filters {
      display: none;
    }
    .bar {
      padding-block: 0;
      margin-bottom: 24px;
    }
    /* Swipe carousel: one card per screen, with the next one peeking in. */
    .grid {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: 8px;
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar {
      display: none;
    }
    .grid > :global(.card) {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }
    .dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      margin-top: 16px;
    }
    /* 32px tap target around a 12px dot. */
    .dots button {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .dots button::before {
      content: '';
      width: 12px;
      height: 12px;
      border: 2px solid var(--ink);
      border-radius: 50%;
    }
    .dots button[aria-current='true']::before {
      background: var(--ink);
    }
    .count {
      margin-left: 8px;
    }
  }
</style>
