---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Frame from './Frame.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  size: 'wide' | 'tall' | 'small';
  eager?: boolean;
}

const { project, size, eager = false } = Astro.props;
const { title, category, year, cover, coverAlt } = project.data;
---

<a class="card" href={`/work/${project.id}/`} data-category={category} data-size={size}>
  <Frame class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 720px) 100vw, 66vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </Frame>
  <div class="meta">
    <h2>{title}</h2>
    <span class="label">{category} / {year}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
  }
  .card[data-size='wide'] {
    grid-column: span 4;
  }
  .card[data-size='tall'],
  .card[data-size='small'] {
    grid-column: span 2;
  }
  .card :global(.media) {
    height: 440px;
    overflow: hidden;
  }
  .card[data-size='small'] :global(.media) {
    height: 320px;
  }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover :global(img) {
    transform: scale(1.03);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h2 {
    font-weight: 700;
    font-size: 26px;
    line-height: 1;
  }
  .card:hover h2 {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .card[data-size] {
      grid-column: 1 / -1;
    }
    .card[data-size] :global(.media) {
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card :global(img) {
      transition: none;
    }
  }
</style>
