---
import { site } from '../data/site';
import Frame from './Frame.astro';
import { url, stripBase } from '../data/url';

const path = stripBase(Astro.url.pathname);
const links = [
  { href: '/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/work') : path.startsWith(href);
const tel = site.phone.replace(/[^\d+]/g, '');
---

<header class="wrap">
  <div class="bar label">
    <a href={url()}>{site.name} / Packaging</a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <button type="button" class="contact-open" aria-haspopup="dialog">Contact</button>
    </nav>
    <button type="button" class="menu-open" aria-haspopup="dialog" aria-label="Open menu">☰ Menu</button>
  </div>
</header>

<!-- Phones only: full-screen menu, and a contact button pinned to the corner. -->
<dialog id="menu" aria-label="Menu">
  <div class="menu-top label">
    <span>{site.name}</span>
    <button type="button" class="close label" aria-label="Close menu">Close ×</button>
  </div>
  <nav class="menu-links" aria-label="Main">
    {
      links.map((l) => (
        <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <button type="button" class="contact-open" aria-haspopup="dialog">Contact</button>
  </nav>
</dialog>

<button type="button" class="contact-open fab label" aria-haspopup="dialog">Contact</button>

<dialog id="contact" aria-labelledby="contact-title">
  <Frame>
    <div class="panel">
      <div class="top">
        <h2 id="contact-title">Contact</h2>
        <button type="button" class="close label" aria-label="Close">Close ×</button>
      </div>
      <dl>
        <div>
          <dt class="label">Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="label">Phone</dt>
          <dd><a href={`tel:${tel}`}>{site.phone}</a></dd>
        </div>
      </dl>
    </div>
  </Frame>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#contact')!;
  const menu = document.querySelector<HTMLDialogElement>('#menu')!;
  document.querySelectorAll('.contact-open').forEach((b) =>
    b.addEventListener('click', () => {
      menu.close();
      dialog.showModal();
    }),
  );
  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  // Close when clicking the backdrop outside the panel.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  document.querySelector('.menu-open')!.addEventListener('click', () => menu.showModal());
  menu.querySelector('.close')!.addEventListener('click', () => menu.close());
</script>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 24px;
    border-bottom: 2px dashed var(--ink);
    font-size: 13px;
  }
  a {
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 24px;
  }
  nav a,
  .contact-open {
    padding-block: 4px;
  }
  .contact-open {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding-inline: 0;
    cursor: pointer;
  }
  a:hover,
  .contact-open:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }

  dialog {
    width: min(560px, calc(100% - 32px));
    padding: 12px;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  dialog::backdrop {
    background: rgb(42 30 18 / 0.55);
  }
  .panel {
    padding: clamp(16px, 4vw, 28px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 2px dashed var(--ink);
  }
  h2 {
    font-size: 56px;
  }
  .close {
    font-family: var(--font-mono);
    background: none;
    border: 2px solid var(--ink);
    color: var(--ink);
    padding: 8px 12px;
    min-height: 40px;
    cursor: pointer;
  }
  .close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  dl {
    margin: 0;
  }
  dl > div {
    padding-block: 20px;
    border-bottom: 2px dashed var(--fold);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 6px 0 0;
  }
  dd a {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(28px, 6vw, 40px);
    line-height: 1;
        overflow-wrap: anywhere;
  }
  dd a:hover {
    color: var(--accent);
  }

  /* Phone-only pieces, hidden on larger screens. */
  .menu-open,
  .fab {
    display: none;
  }
  .menu-open {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink);
    background: none;
    border: 2px solid var(--ink);
    padding: 8px 12px;
    min-height: 40px;
    cursor: pointer;
  }
  #menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 24px var(--gutter);
    background: var(--kraft);
    overflow: auto;
  }
  #menu::backdrop {
    background: var(--kraft);
  }
  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 2px dashed var(--ink);
  }
  .menu-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin-top: 24px;
  }
  .menu-links a,
  .menu-links .contact-open {
    width: 100%;
    text-align: left;
    padding-block: 16px;
    border-bottom: 2px dashed var(--fold);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 56px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .fab {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 10;
    padding: 14px 20px;
    font-size: 14px;
    background: var(--ink);
    color: var(--kraft);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .fab:hover {
    color: var(--kraft);
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: nowrap;
      padding-block: 16px;
    }
    .bar > nav {
      display: none;
    }
    .menu-open,
    .fab {
      display: block;
    }
  }
</style>
