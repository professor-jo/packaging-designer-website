---
import { site } from '../data/site';
---

<footer class="wrap">
  <div class="inner">
    <div>
      <p class="label">Get in touch</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <ul class="label">
      {site.social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
    </ul>
    <p class="copy label">© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 120px;
  }
  .inner {
    padding-block: 48px;
    border-top: 2px dashed var(--ink);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
  }
  .label {
    margin: 0 0 8px;
  }
  .email {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .email:hover,
  ul a:hover {
    color: var(--accent);
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 20px;
  }
  ul a {
    display: inline-block;
    padding: 12px 22px;
    border: 2px solid var(--ink);
    font-size: 18px;
    text-decoration: none;
  }
  ul a:hover {
    border-color: var(--accent);
  }
  .copy {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
